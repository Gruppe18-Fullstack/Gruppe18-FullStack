@model Gruppe18_FullStack.Models.WeatherReading

@{
    ViewData["Title"] = "Create";
}

<div class="max-w-md mx-auto mt-8">
    <h1 class="text-2xl font-bold text-slate-800 mb-2">Create Weather Reading</h1>
    <p class="text-slate-500 mb-6">Add a new weather measurement</p>

    <form asp-action="Create" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-red-500"></div>

        <div>
            <label asp-for="Temperature" class="block font-medium mb-1"></label>
            <input asp-for="Temperature" class="w-full border rounded px-3 py-2" />
            <span asp-validation-for="Temperature" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="WindSpeed" class="block font-medium mb-1"></label>
            <input asp-for="WindSpeed" class="w-full border rounded px-3 py-2" />
            <span asp-validation-for="WindSpeed" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="Humidity" class="block font-medium mb-1"></label>
            <input asp-for="Humidity" class="w-full border rounded px-3 py-2" />
            <span asp-validation-for="Humidity" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="RecordedAt" class="block font-medium mb-1"></label>
            <input asp-for="RecordedAt" class="w-full border rounded px-3 py-2" />
            <span asp-validation-for="RecordedAt" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label class="block font-medium mb-1">Station</label>
            <select asp-for="WeatherStationId"
                    asp-items="ViewBag.WeatherStationId"
                    class="w-full border rounded px-3 py-2">
                <option value="">-- Select a station --</option>
            </select>
            <span asp-validation-for="WeatherStationId" class="text-red-500 text-sm"></span>
        </div>

        <div class="pt-2">
            <input type="submit" value="Create"
                   class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" />
        </div>
    </form>

    <div class="mt-4">
        <a asp-action="Index" class="text-blue-600 hover:underline">Back to List</a>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

