@model Gruppe18_FullStack.Models.WeatherReading

@{
    ViewData["Title"] = "Details";
}

<div class="max-w-md mx-auto mt-8">
    <h1 class="text-2xl font-bold text-slate-800 mb-2">Weather Reading Details</h1>
    <p class="text-slate-500 mb-6">View weather measurement information</p>

    <div class="border rounded p-4 space-y-3">
        <div>
            <span class="font-medium">Temperature:</span>
            <span>@Html.DisplayFor(model => model.Temperature)</span>
        </div>

        <div>
            <span class="font-medium">WindSpeed:</span>
            <span>@Html.DisplayFor(model => model.WindSpeed)</span>
        </div>

        <div>
            <span class="font-medium">Humidity:</span>
            <span>@Html.DisplayFor(model => model.Humidity)</span>
        </div>

        <div>
            <span class="font-medium">RecordedAt:</span>
            <span>@Html.DisplayFor(model => model.RecordedAt)</span>
        </div>

        <div>
            <span class="font-medium">Station:</span>
            <span>@Html.DisplayFor(model => model.WeatherStation.Location)</span>
        </div>
    </div>

    <div class="mt-4 space-x-3">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="text-blue-600 hover:underline">Edit</a>
        <a asp-action="Index" class="text-blue-600 hover:underline">Back to List</a>
    </div>
</div>

