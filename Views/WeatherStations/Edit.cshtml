@model Gruppe18_FullStack.Models.WeatherStation

@{
    ViewData["Title"] = "Edit";
}

<div class="max-w-md mx-auto mt-8">
    <h1 class="text-2xl font-bold text-slate-800 mb-2">Edit Weather Station</h1>
    <p class="text-slate-500 mb-6">Update the station details below</p>

    <form asp-action="Edit" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-red-500"></div>
        <input type="hidden" asp-for="Id" />

        <div>
            <label asp-for="Name" class="block font-medium mb-1"></label>
            <input asp-for="Name" class="w-full border rounded px-3 py-2" />
            <span asp-validation-for="Name" class="text-red-500 text-sm"></span>
        </div>
        <div>
            <label asp-for="Location" class="block font-medium mb-1"></label>
            <input asp-for="Location" class="w-full border rounded px-3 py-2" />
            <span asp-validation-for="Location" class="text-red-500 text-sm"></span>
        </div>
        <div>
            <label asp-for="Latitude" class="block font-medium mb-1"></label>
            <input asp-for="Latitude" class="w-full border rounded px-3 py-2" />
            <span asp-validation-for="Latitude" class="text-red-500 text-sm"></span>
        </div>

        <div class="pt-2">
            <input type="submit" value="Save" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" />
        </div>
    </form>

    <div class="mt-4">
        <a asp-action="Index" class="text-blue-600 hover:underline">Back to List</a>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

