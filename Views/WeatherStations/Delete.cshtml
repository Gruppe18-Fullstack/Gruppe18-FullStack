@model Gruppe18_FullStack.Models.WeatherStation

@{
    ViewData["Title"] = "Delete";
}

<div class="max-w-md mx-auto mt-8">
    <h1 class="text-2xl font-bold text-red-600 mb-2">Delete Weather Station</h1>
    <p class="text-slate-500 mb-6">Are you sure you want to delete this?</p>

    <div class="border rounded p-4 space-y-3">
        <div>
            <span class="font-medium">Name:</span>
            <span>@Html.DisplayFor(model => model.Name)</span>
        </div>

        <div>
            <span class="font-medium">Location:</span>
            <span>@Html.DisplayFor(model => model.Location)</span>
        </div>

        <div>
            <span class="font-medium">Latitude:</span>
            <span>@Html.DisplayFor(model => model.Latitude)</span>
        </div>

        <div>
            <span class="font-medium">Longitude:</span>
            <span>@Html.DisplayFor(model => model.Longitude)</span>
        </div>
    </div>

    <form asp-action="Delete" class="mt-4 space-x-3">
        <input type="hidden" asp-for="Id" />

        <input type="submit" value="Delete"
               class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700" />

        <a asp-action="Index" class="text-blue-600 hover:underline">Back to List</a>
    </form>
</div>